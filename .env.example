# News API - get a free key at https://newsapi.org
NEWS_API_KEY=your_newsapi_key_here

# Groq API - get a free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Resend API - get a free key at https://resend.com
RESEND_API_KEY=your_resend_api_key_here

# Email addresses
# Note: on Resend's free tier, EMAIL_FROM must be "onboarding@resend.dev"
# until you verify your own domain. You can still send to any EMAIL_TO address.
EMAIL_FROM=onboarding@resend.dev
EMAIL_TO=recipient@example.com

# Optional: additional recipients (comma-separated)
# EMAIL_CC=person1@example.com,person2@example.com
